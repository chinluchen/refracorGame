; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="refractorGame"
run/main_scene="res://scenes/start.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/images/icon.svg"

[autoload]

CursorManage="*res://script/cursor_manage.gd"
RefractorState="*res://script/refractor_state.gd"
AudioRoot="*res://assets/sounds/audio_root.tscn"
SceneManager="*res://script/scene_manager.gd"
ActionLogger="*res://script/actionLogger.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/stretch/mode="viewport"
mouse_cursor/custom_image="res://assets/images/hand.png"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true
version_control/custom_image="res://images/hand.png"

[gui]

theme/custom_font="res://fonts/Cubic_11.woff2"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
